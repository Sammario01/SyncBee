{
  "name": "syncbee",
  "productName": "SyncBee",
  "version": "1.0.1",
  "description": "SyncBee: offline exam engine by Mariobee",
  "author": "Mariobee Technologies Limited",
  "license": "UNLICENSED",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "rebuild-native": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --target=30.0.1 --arch=x64 --dist-url=https://electronjs.org/headers --runtime=electron --release && cd ../..",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64",
    "prebuild:dev": "powershell -NoProfile -Command \"Get-Process SyncBee,electron,SyncBee.exe -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 2; if (Test-Path dist) { cmd /c 'rd /s /q dist' 2>$null }; if (Test-Path dist) { Write-Error 'Could not delete dist/ - a file is locked. Close the app or VS Code and retry.'; exit 1 }\"",
    "prebuild:ship": "powershell -NoProfile -Command \"Get-Process SyncBee,electron,SyncBee.exe -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 2; if (Test-Path dist) { cmd /c 'rd /s /q dist' 2>$null }; if (Test-Path dist) { Write-Error 'Could not delete dist/ - a file is locked. Close the app or VS Code and retry.'; exit 1 }\"",
    "build:dev": "npm run pack",
    "build:ship": "npm run dist"
  },
  "keywords": [],
  "dependencies": {
    "@culvert/zip": "0.2.0",
    "archiver": "^5.3.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "builder-util": "^26.16.0",
    "electron-updater": "^6.8.11",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "p-limit": "^3.1.0",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "30.0.1",
    "electron-builder": "^26.3.2"
  },
  "build": {
    "appId": "com.mariobee.syncbee",
    "productName": "SyncBee",
    "copyright": "Copyright © 2026 Mariobee Technologies Limited",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "server/**/*",
      "db/**/*.js",
      "license/**/*.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@electron/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/node-gyp/**",
      "!node_modules/dmg-builder/**",
      "!node_modules/electron-rebuild/**",
      "!node_modules/@electron/rebuild/**",
      "!license/MANAGEBACKUP.js",
      "!build/keys/**",
      "!scripts/**",
      "!**/*.pem",
      "!**/*.key",
      "!**/.env*",
      "!**/test-*.js",
      "!**/debug-*.js",
      "!**/seed-*.js"
    ],
    "asar": true,
    "afterPack": "./scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "Sammario01",
      "repo": "SyncBee",
      "private": true,
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "../../.cache/puppeteer/chrome",
        "to": "puppeteer-cache/chrome",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncBee",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
